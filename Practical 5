using System; 
using System.Web.UI; 
namespace Practical5 
{ 
    public partial class WebForm1 : System.Web.UI.Page 
    { 
        protected void Page_Load(object sender, EventArgs e) 
        { 
            if (!IsPostBack) 
            { 
                if (Session["LeaveDate"] != null) 
                { 
                    DateTime selectedDate = (DateTime)Session["LeaveDate"]; 
                    Label4.Text = selectedDate.ToString("dd/MM/yyyy"); 
                } 
                else 
                { 
                    Label4.Text = "No date selected"; 
                } 
            } 
        } 
        protected void Button1_Click(object sender, EventArgs e) 
        { 
            // Check whether a date exists in Session 
          if (Session["LeaveDate"] == null) 
            { 
                Label7.Text = "Please select a leave date."; 
                return; 
            } 
            // Check whether leave type has been selected 
            if (DropDownList1.SelectedIndex == 0) 
            { 
                Label7.Text = "Please select a leave type."; 
                return; 
            } 
            // Get selected date from Session 
            DateTime selectedDate = (DateTime)Session["LeaveDate"]; 
            // Get selected leave type from DropDownList 
            string leaveType = DropDownList1.SelectedValue; 
            // Display confirmation message 
            Label7.Text = leaveType + " has been applied on " 
                        + selectedDate.ToString("dd/MM/yyyy") + "."; 
        } 
    } 
}
