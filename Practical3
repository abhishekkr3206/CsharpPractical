using System;

class Program
{
    static void Main(string[] args)
    {
        string[] category = new string[10];
        double[] amount = new double[10];

        int count = 0;
        int choice = 0;
        double total = 0;

        do
        {
            Console.WriteLine("\n========== Expense Tracking Module ==========");
            Console.WriteLine("1. Add Expense");
            Console.WriteLine("2. View Expenses");
            Console.WriteLine("3. Show Total Expense");
            Console.WriteLine("4. Exit");
            Console.Write("Enter your choice: ");

            try
            {
                choice = Convert.ToInt32(Console.ReadLine());

                switch (choice)
                {
                    case 1:

                        if (count >= 10)
                        {
                            Console.WriteLine("Expense list is full!");
                            break;
                        }

                        Console.Write("Enter Expense Category: ");
                        category[count] = Console.ReadLine() ?? string.Empty;

                        if (string.IsNullOrWhiteSpace(category[count]))
                        {
                            throw new Exception("Category cannot be empty.");
                        }

                        Console.Write("Enter Expense Amount: ");
                        amount[count] = Convert.ToDouble(Console.ReadLine());

                        if (amount[count] <= 0)
                        {
                            throw new Exception("Amount must be greater than 0.");
                        }

                        total += amount[count];
                        count++;

                        Console.WriteLine("Expense Added Successfully!");
                        break;

                    case 2:

                        if (count == 0)
                        {
                            Console.WriteLine("No expenses found.");
                        }
                        else
                        {
                            Console.WriteLine("\n------ Expense List ------");

                            for (int i = 0; i < count; i++)
                            {
                                Console.WriteLine((i + 1) + ". Category: " + category[i] +
                                                  " | Amount: ₹" + amount[i]);
                            }
                        }

                        break;

                    case 3:

                        Console.WriteLine("\nTotal Expense = ₹" + total);
                        break;

                    case 4:

                        Console.WriteLine("Thank You! Program Closed.");
                        break;

                    default:

                        Console.WriteLine("Invalid Choice! Please enter 1 to 4.");
                        break;
                }
            }
            catch (FormatException)
            {
                Console.WriteLine("Invalid Input! Please enter numbers only.");
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error: " + ex.Message);
            }

        } while (choice != 4);

        Console.WriteLine("\nPress any key to exit...");
        Console.ReadKey();
    }
}
